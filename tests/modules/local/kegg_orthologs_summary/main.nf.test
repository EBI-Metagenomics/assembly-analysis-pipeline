nextflow_process {
    name "Test Process KEGG_ORTHOLOGS_SUMMARY"
    script "modules/local/kegg_orthologs_summary.nf"
    process "KEGG_ORTHOLOGS_SUMMARY"

    test("Should count each protein once per KO and map FGS protein IDs to contigs") {
        setup {
            run("TABIX_BGZIP") {
                script "modules/nf-core/tabix/bgzip/main.nf"
                process {
                    """
                    input[0] = [
                        [id: 'hits'],
                        file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/hits.domtblout", checkIfExists: true)
                    ]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = TABIX_BGZIP.out.output.map { _meta, domtblout -> [[id: 'ERZ_TEST'], domtblout] }
                input[1] = file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/ko_list", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            // ERZ1_1_1 has two K00001 domains, it is counted once
            assert path(process.out.ko_summary_tsv.get(0).get(1)).linesGzip == [
                'ko\tdescription\tcount',
                'K00001\talcohol dehydrogenase [EC:1.1.1.1]\t3',
                'K00002\talcohol dehydrogenase (NADP+) [EC:1.1.1.2]\t1'
            ]
            // One row per protein, so ERZ1_1 has K00001 two times (ERZ1_1_1 and ERZ1_1_2)
            assert path(process.out.ko_per_contig_tsv.get(0).get(1)).linesGzip == [
                'ko\tcontig_id',
                'K00001\tERZ1_1',
                'K00001\tERZ1_1',
                'K00001\tERZ1_2',
                'K00002\tERZ1_3',
                'K99999\tERZ1_4'
            ]
        }
    }

    test("Should leave KOs not in ko_list out of the summary but keep them per contig") {
        setup {
            run("TABIX_BGZIP") {
                script "modules/nf-core/tabix/bgzip/main.nf"
                process {
                    """
                    input[0] = [
                        [id: 'hits'],
                        file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/hits.domtblout", checkIfExists: true)
                    ]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = TABIX_BGZIP.out.output.map { _meta, domtblout -> [[id: 'ERZ_TEST'], domtblout] }
                input[1] = file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/ko_list", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            def summary_kos = path(process.out.ko_summary_tsv.get(0).get(1)).linesGzip.collect { it.split('\t')[0] }
            def per_contig_kos = path(process.out.ko_per_contig_tsv.get(0).get(1)).linesGzip.collect { it.split('\t')[0] }
            assert !('K99999' in summary_kos)
            assert 'K99999' in per_contig_kos
            // K00003 is in ko_list but has no hits
            assert !('K00003' in summary_kos)
        }
    }

    test("Should fail when ko_list has no knum column") {
        // The input has only one hit, so the sanity check is skipped.
        // Only pipefail can stop the task when csvtk join fails.
        setup {
            run("TABIX_BGZIP") {
                script "modules/nf-core/tabix/bgzip/main.nf"
                process {
                    """
                    input[0] = [
                        [id: 'single_hit'],
                        file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/single_hit.domtblout", checkIfExists: true)
                    ]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = TABIX_BGZIP.out.output.map { _meta, domtblout -> [[id: 'ERZ_TEST'], domtblout] }
                input[1] = file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/ko_list_no_knum_column", checkIfExists: true)
                """
            }
        }
        then {
            assert process.failed
        }
    }

    test("Should create all declared outputs in stub mode") {
        options "-stub"
        setup {
            run("TABIX_BGZIP") {
                script "modules/nf-core/tabix/bgzip/main.nf"
                process {
                    """
                    input[0] = [
                        [id: 'hits'],
                        file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/hits.domtblout", checkIfExists: true)
                    ]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = TABIX_BGZIP.out.output.map { _meta, domtblout -> [[id: 'ERZ_TEST'], domtblout] }
                input[1] = file("${projectDir}/tests/modules/local/kegg_orthologs_summary/fixtures/ko_list", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assert path(process.out.ko_summary_tsv.get(0).get(1)).linesGzip == []
            assert path(process.out.ko_per_contig_tsv.get(0).get(1)).linesGzip == []
            assert snapshot(process.out).match()
        }
    }
}
